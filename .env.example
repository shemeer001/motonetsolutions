# ----------------------------------------------------------------------------
# MotoNet Solutions — Environment Variables (EXAMPLE)
# Copy this file to `.env` and fill in real values. NEVER commit your real .env.
# ----------------------------------------------------------------------------

# PostgreSQL connection string used by Prisma.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://user:password@localhost:5432/motonet?schema=public"

# Base URL of the site (used for SEO, robots.txt, sitemap, absolute links).
# In local dev this is typically http://localhost:3000
NEXTAUTH_URL="http://localhost:3000"
